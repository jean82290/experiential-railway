# Public front door for the Experiential gateway.
#
# Experiential only listens on 127.0.0.1 and trusts anything that reaches it
# there: its usage report and metrics answer without a key. Caddy is the only
# thing Railway can reach, and it forwards just three groups of routes:
#
#   /health/*         content-free health checks (Railway's health check uses one)
#   /v1/*             the API; the gateway itself checks every virtual key
#   /usage, /metrics  with a virtual key: that key's own usage, checked by the
#                     gateway; without one: the admin password (user "admin")
#
# Everything else gets a 404. The entrypoint sets the {$...} variables.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# Railway's edge terminates TLS and forwards from its private network.
		trusted_proxies static private_ranges
	}
	log {
		level WARN
	}
}

:{$PORT} {
	@health path /health/live /health/ready
	handle @health {
		reverse_proxy 127.0.0.1:{$EXP_INTERNAL_PORT}
	}

	handle /v1/* {
		reverse_proxy 127.0.0.1:{$EXP_INTERNAL_PORT} {
			# Stream tokens to the client as they arrive.
			flush_interval -1
		}
	}

	@usageWithKey {
		path /usage /usage.json
		header Authorization "Bearer *"
	}
	handle @usageWithKey {
		reverse_proxy 127.0.0.1:{$EXP_INTERNAL_PORT}
	}

	@admin path /usage /usage.json /metrics /metrics.json
	handle @admin {
		route {
			basic_auth {
				admin {$EXP_ADMIN_PASSWORD_HASH}
			}
			# Without an Authorization header the gateway shows the whole organization.
			request_header -Authorization
			reverse_proxy 127.0.0.1:{$EXP_INTERNAL_PORT}
		}
	}

	handle / {
		header Content-Type "application/json; charset=utf-8"
		respond `{"service":"experiential-gateway","openai_base_url":"/v1","anthropic_base_url":"/","health":"/health/ready","usage":"/usage"}` 200
	}

	handle {
		respond `{"error":{"message":"Not found. The API is under /v1.","type":"not_found"}}` 404
	}
}
